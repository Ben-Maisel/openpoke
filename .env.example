# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API key for LLM access
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Optional: Model selection (any OpenRouter model id; see https://openrouter.ai/models)
# OPENPOKE_MODEL sets every slot; the per-slot variables override it.
# Default when unset: anthropic/claude-haiku-5.5
# OPENPOKE_MODEL=anthropic/claude-haiku-5.5
# OPENPOKE_INTERACTION_AGENT_MODEL=
# OPENPOKE_EXECUTION_AGENT_MODEL=
# OPENPOKE_SEARCH_MODEL=
# OPENPOKE_SUMMARIZER_MODEL=
# OPENPOKE_EMAIL_CLASSIFIER_MODEL=

# Optional: how much of its own recent runs each execution agent sees (estimated tokens; older runs
# are covered by the agent's card). Default 4000.
# OPENPOKE_EXECUTION_HISTORY_TOKENS=4000

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs
